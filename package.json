{
  "name": "PopReplay",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n server,web -c green,blue \"HOST=0.0.0.0 pnpm --filter @getmoney/server dev\" \"wait-on tcp:2567 && pnpm --filter quivio dev\"",
    "start": "pnpm --parallel --filter=@getmoney/server start & pnpm --filter=quivio dev",
    "server": "pnpm --filter=@getmoney/server start",
    "web": "pnpm --filter=quivio dev",
    "build": "pnpm --filter=@shared run build && pnpm --filter=@getmoney/server run build && pnpm --filter=quivio run build",
    "build:server": "pnpm --filter=@getmoney/server run build",
    "test": "CI=1 pnpm -r --if-present run test",
    "test:parallel": "CI=1 pnpm -r --parallel --if-present run test",
    "test:web:watch": "pnpm --filter=quivio run test:watch",
    "fetch:questions": "pnpm --filter server exec tsx src/scripts/fetchQuestionsByTopic.ts",
    "vercel:set-branch-env": "node scripts/setVercelBranchEnv.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "pg": "^8.16.3",
    "tsx": "^4.10.2",
    "wait-on": "^8.0.4"
  }
}
