{
  "name": "PopReplay",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @getmoney/server dev\" \"pnpm --filter quivio dev\"",
    "start": "pnpm --parallel --filter=@getmoney/server start & pnpm --filter=web dev",
    "server": "pnpm --filter=@getmoney/server start",
    "web": "pnpm --filter=web dev",
    "build": "pnpm --filter=@shared run build && pnpm --filter=@getmoney/server run build && pnpm --filter=web run build",
    "build:server": "pnpm --filter=@getmoney/server run build",
    "test": "CI=1 pnpm -r --if-present run test",
    "test:parallel": "CI=1 pnpm -r --parallel --if-present run test",
    "test:web:watch": "pnpm --filter=web run test:watch",
    "fetch:questions": "pnpm --filter server exec tsx src/scripts/fetchQuestionsByTopic.ts",
    "vercel:set-branch-env": "node scripts/setVercelBranchEnv.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
