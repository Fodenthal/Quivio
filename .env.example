# =============================================================================
# Quivio Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# =============================================================================
# Node.js Environment
# =============================================================================
# Set to 'development', 'production', or 'test'
NODE_ENV=development

# =============================================================================
# Colyseus Server Configuration
# =============================================================================
# WebSocket server URL for the Colyseus game server
# Used by the web frontend to connect to the game server
NEXT_PUBLIC_BACKEND_URL=ws://localhost:2567

# =============================================================================
# AI Services
# =============================================================================
# Google Gemini API key for AI question generation
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Database Configuration
# =============================================================================
# Database type: 'sqlite' (current) or 'supabase' (future migration)
DATABASE_TYPE=sqlite

# Supabase configuration for PostgreSQL database
# Required when DATABASE_TYPE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=30000

# Database retry configuration
DATABASE_MAX_RETRIES=3
DATABASE_RETRY_BACKOFF_MS=1000
DATABASE_TIMEOUT_MS=5000

# Database health check settings
DATABASE_HEALTH_CHECK_INTERVAL=30000
DATABASE_HEALTH_CHECK_TIMEOUT=5000
DATABASE_HEALTH_CHECK_ENABLED=true

# Database debug logging
DATABASE_DEBUG=false

# =============================================================================
# RAG Service Configuration (Python Microservice)
# =============================================================================
# Optional: Google Search API for enhanced web search capabilities
# Uncomment and configure for enhanced RAG functionality
# GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
# GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here

# =============================================================================
# Development & Debugging
# =============================================================================
# Enable debug logging (development only)
DEBUG=false

# =============================================================================
# Security & CORS
# =============================================================================
# CORS origins for development (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Performance & Scaling
# =============================================================================
# Maximum number of concurrent connections per room
# MAX_CONNECTIONS_PER_ROOM=20

# =============================================================================
# Monitoring & Analytics
# =============================================================================
# Enable detailed logging for monitoring
# LOG_LEVEL=info

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# Cookiebot CMP (required for Consent Mode)
NEXT_PUBLIC_COOKIEBOT_ID=your_cookiebot_id_here

# =============================================================================
# File Paths & Storage
# =============================================================================
# Path for SQLite database file (server only)
# DATABASE_PATH=./questions.db

# =============================================================================
# Game Configuration
# =============================================================================
# Default game settings
# DEFAULT_TARGET_SCORE=100
# DEFAULT_ROUND_TIME=30
# DEFAULT_MAX_PLAYERS=10

# =============================================================================
# API Rate Limiting
# =============================================================================
# Rate limits for external API calls
# GEMINI_RATE_LIMIT=100
# GEMINI_RATE_LIMIT_WINDOW=60000

# =============================================================================
# Testing Configuration
# =============================================================================
# Test-specific environment variables
# TEST_DATABASE_PATH=./test-questions.db
# TEST_GEMINI_API_KEY=test_key_for_testing_only

# =============================================================================
# Deployment Configuration
# =============================================================================
# Production deployment settings
# PORT=2567
# HOST=0.0.0.0
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Notes
# =============================================================================
# - All NEXT_PUBLIC_* variables are exposed to the browser
# - Keep sensitive keys (API keys, database credentials) private
# - Use different values for development, staging, and production
# - Never commit actual .env files to version control
