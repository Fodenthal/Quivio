{
  "private": true,
  "name": "my-app",
  "version": "1.0.0",
  "description": "npm init template for bootstrapping an empty Colyseus project",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "dev": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "loadtest:trivia": "tsx loadtest/trivia_test.ts",
    "build": "npm run clean && tsc",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**_test.ts --exit --timeout 15000",
    "test:trivia": "mocha -r tsx test/TriviaRoom_test.ts --exit --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.16.0",
    "@colyseus/testing": "^0.16.0",
    "@types/express": "^4.17.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.4",
    "colyseus.js": "^0.16.19",
    "mocha": "^10.2.0",
    "rimraf": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.10.2",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.18",
    "@colyseus/monitor": "^0.16.7",
    "@colyseus/playground": "^0.16.4",
    "@colyseus/schema": "^3.0.42",
    "@colyseus/tools": "^0.16.12",
    "colyseus": "^0.16.4",
    "dotenv": "^16.5.0",
    "express": "^4.21.2"
  }
}
