    "test:cohere": "npx tsx test_cohere_connectivity.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "migrate:sqlite-to-supabase": "tsx migrations/migrate_sqlite_to_supabase.ts",
    "migrate:status": "tsx migrations/check_migration_status.ts",
    "migrate:verify": "tsx migrations/verify_setup.ts",
    "vector:setup": "tsx migrations/setup_vector_store.ts"
  },
