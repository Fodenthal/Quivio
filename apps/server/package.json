{
  "name": "@getmoney/server",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node lib/index.js",
    "dev": "ts-node-dev --files --watch src --respawn src/index.ts",
    "loadtest": "ts-node-dev --files src/loadtest/stress_test.ts",
    "loadtest:trivia": "tsx loadtest/trivia_test.ts",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**_test.ts --exit --timeout 15000",
    "test:trivia": "mocha -r tsx test/TriviaRoom_test.ts --exit --timeout 15000",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.16.0",
    "@colyseus/testing": "^0.16.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.4",
    "dotenv": "^16.5.0",
    "mocha": "^10.2.0",
    "rimraf": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.10.2",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.18",
    "@colyseus/monitor": "^0.16.7",
    "@colyseus/playground": "^0.16.4",
    "@colyseus/schema": "^3.0.42",
    "@colyseus/tools": "^0.16.12",
    "@google/generative-ai": "^0.21.0",
    "@shared": "workspace:*",
    "colyseus": "^0.16.4",
    "colyseus.js": "^0.16.19",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  }
}
